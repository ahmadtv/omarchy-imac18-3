+/*
+ * Scaled modes on a stitched panel. The panel only ever runs its native
+ * stitched timing (both tiles at tile_w x tile_h). A smaller crtc mode is a
+ * logical mode, as on any eDP panel: the streams keep the native tile timing
+ * and the primary plane is scaled onto the panel, split at the tile seam.
+ * Sizes from 640x360 up to the stitched size are accepted.
+ */
+static bool amdgpu_dm_tiled_stitch_mode_is_scaled(
+		const struct drm_connector *connector,
+		const struct drm_display_mode *mode)
+{
+	int tile_w, tile_h;
+
+	if (!amdgpu_dm_link_is_tiled_stitch_root(
+			to_amdgpu_dm_connector(connector)->dc_link))
+		return false;
+	if (!amdgpu_dm_connector_tiled_stitch_geometry(connector, &tile_w, &tile_h))
+		return false;
+	if (mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN))
+		return false;
+
+	return mode->hdisplay >= 640 && mode->vdisplay >= 360 &&
+	       mode->hdisplay <= 2 * tile_w && mode->vdisplay <= tile_h;
+}
+
+/* A mode the stitched root can show: its own stitched mode, or a scaled one. */
+static bool amdgpu_dm_tiled_stitch_mode_is_usable(
+		const struct drm_connector *connector,
+		const struct drm_display_mode *mode)
+{
+	return amdgpu_dm_tiled_stitch_mode_is_stitched(connector, mode) ||
+	       amdgpu_dm_tiled_stitch_mode_is_scaled(connector, mode);
+}
