+
+static int amdgpu_dm_tiled_stitch_add_scaled_modes(struct drm_connector *connector,
+						   const struct drm_display_mode *native)
+{
+	struct drm_display_mode *m;
+	int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(tiled_stitch_scaled_sizes); i++) {
+		int w = tiled_stitch_scaled_sizes[i].w;
+		int h = tiled_stitch_scaled_sizes[i].h;
+
+		if (w > native->hdisplay || h > native->vdisplay ||
+		    (w == native->hdisplay && h == native->vdisplay))
+			continue;
+
+		m = drm_mode_duplicate(connector->dev, native);
+		if (!m)
+			continue;
+		m->hdisplay = w;
+		m->vdisplay = h;
+		m->type = DRM_MODE_TYPE_DRIVER;
+		drm_mode_set_name(m);
+		drm_mode_probed_add(connector, m);
+		n++;
+	}
+
+	return n;
+}
