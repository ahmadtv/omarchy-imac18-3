+static void tiled_stitch_set_plane_rects(struct dc_plane_state *p,
+					 const struct tiled_stitch_rects *r)
+{
+	p->src_rect = r->src;
+	p->dst_rect = r->dst;
+	p->clip_rect = r->clip;
 }
 
