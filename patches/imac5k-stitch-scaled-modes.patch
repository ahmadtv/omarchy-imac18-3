+/*
+ * Where the crtc mode's area lands on the panel (panel_w x panel_h), by the
+ * same rules as update_stream_scaling_settings(): RMX_FULL stretches,
+ * RMX_CENTER is 1:1, RMX_ASPECT and RMX_OFF fit preserving the aspect ratio
+ * (RMX_OFF: the panel cannot run anything but its native timing).
+ */
+static struct rect tiled_stitch_canvas(int mode_w, int mode_h,
+				       int panel_w, int panel_h,
+				       enum amdgpu_rmx_type rmx)
+{
+	struct rect c = { 0, 0, panel_w, panel_h };
+
+	if (mode_w <= 0 || mode_h <= 0)
+		return c;
+
+	if (rmx == RMX_CENTER) {
+		c.width = min(mode_w, panel_w);
+		c.height = min(mode_h, panel_h);
+	} else if (rmx != RMX_FULL) {
+		if (mode_w * panel_h < mode_h * panel_w)
+			c.width = mode_w * panel_h / mode_h;
+		else
+			c.height = mode_h * panel_w / mode_w;
+	}
+
+	c.x = (panel_w - c.width) / 2;
+	c.y = (panel_h - c.height) / 2;
+	return c;
+}
+
+static struct rect tiled_stitch_clip(struct rect r, int w, int h)
+{
+	int x0 = max(r.x, 0), y0 = max(r.y, 0);
+	int x1 = min(r.x + r.width, w), y1 = min(r.y + r.height, h);
+
+	return (struct rect){ x0, y0, max(x1 - x0, 0), max(y1 - y0, 0) };
+}
+
+struct tiled_stitch_rects {
+	struct rect src, dst, clip;
+};
