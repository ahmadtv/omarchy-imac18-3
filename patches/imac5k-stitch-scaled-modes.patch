+static const struct { int w, h; } tiled_stitch_scaled_sizes[] = {
+	{ 3840, 2160 }, { 3200, 1800 }, { 2880, 1620 }, { 2560, 1600 },
+	{ 2560, 1440 }, { 2048, 1152 }, { 1920, 1200 }, { 1920, 1080 },
+	{ 1680, 1050 }, { 1600,  900 }, { 1440,  900 }, { 1280,  800 },
+	{ 1280,  720 },
