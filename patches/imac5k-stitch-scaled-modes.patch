+/*
+ * Split a primary plane across the two tile streams of a stitched crtc.
+ * @ps is the DRM plane state (src in 16.16 framebuffer coordinates, crtc
+ * rect in the crtc mode's coordinates) and @mode the crtc mode: the stitched
+ * mode itself or a scaled one. The mode's area is placed on the panel
+ * (2*tile_w x tile_h) by tiled_stitch_canvas(), the plane's crtc rect mapped
+ * into it, and the result cut at the tile seam: out[0] is the root (left)
+ * tile's src/dst/clip, out[1] the peer (right) tile's, dst and clip in tile
+ * stream space. Each tile's source starts exactly at its src_rect.x, with no
+ * overlap across the seam: on DCE the cursor position is programmed
+ * relative to that offset (translate_by_source), so the viewport must begin
+ * there. For the stitched mode this is the exact halving it always was.
+ * Returns false when the plane does not cross the seam.
+ */
+static bool tiled_stitch_split_plane(const struct drm_plane_state *ps,
+				     const struct drm_display_mode *mode,
+				     int tile_w, int tile_h,
+				     enum amdgpu_rmx_type rmx,
+				     struct tiled_stitch_rects out[2])
+{
+	int mw = mode->hdisplay, mh = mode->vdisplay;
+	int sx = ps->src_x >> 16, sy = ps->src_y >> 16;
+	int sw = ps->src_w >> 16, sh = ps->src_h >> 16;
+	int cw = ps->crtc_w, ch = ps->crtc_h;
+	int x0, x1, y0, y1, seam;
+	struct rect c;
+
+	if (mw <= 0 || mh <= 0 || sw <= 0 || sh <= 0 || cw <= 0 || ch <= 0)
+		return false;
+
+	c = tiled_stitch_canvas(mw, mh, 2 * tile_w, tile_h, rmx);
+
+	x0 = c.x + (int)div_s64((s64)ps->crtc_x * c.width, mw);
+	x1 = c.x + (int)div_s64((s64)(ps->crtc_x + cw) * c.width, mw);
+	y0 = c.y + (int)div_s64((s64)ps->crtc_y * c.height, mh);
+	y1 = c.y + (int)div_s64((s64)(ps->crtc_y + ch) * c.height, mh);
+
+	if (x0 >= tile_w || x1 <= tile_w || y1 <= y0)
+		return false;
+
+	/* the source column under the seam, rounded to the nearest */
+	seam = sx + (int)div_s64((s64)(tile_w - x0) * sw + (x1 - x0) / 2,
+				 x1 - x0);
+	if (seam <= sx || seam >= sx + sw)
+		return false;
+
+	out[0].src = (struct rect){ sx, sy, seam - sx, sh };
+	out[0].dst = (struct rect){ x0, y0, tile_w - x0, y1 - y0 };
+	out[1].src = (struct rect){ seam, sy, sx + sw - seam, sh };
+	out[1].dst = (struct rect){ 0, y0, x1 - tile_w, y1 - y0 };
+	out[0].clip = tiled_stitch_clip(out[0].dst, tile_w, tile_h);
+	out[1].clip = tiled_stitch_clip(out[1].dst, tile_w, tile_h);
+	return true;
+}
