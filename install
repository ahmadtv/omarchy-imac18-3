#!/usr/bin/env bash
# One-line bootstrap for the iMac18,3 patcher.
#
#   bash <(curl -fsSL https://raw.githubusercontent.com/ahmadtv/omarchy-imac18-3/main/install)
#
# Clones (or updates) this repo to a stable location and launches the patcher's
# menu. It applies nothing on its own — the menu still shows what's applied and
# asks before every change. Run it as your normal user; the patcher escalates
# with sudo only for the individual steps that need it.
#
# Pass arguments straight through, e.g. to skip the menu:
#   bash <(curl -fsSL .../install) --apply 5k
#   bash <(curl -fsSL .../install) --remove all     # undo every change
#
# Run from a checkout (./install), it launches that checkout's patcher as it
# is -- your branch, your edits -- and pulls nothing. IMAC_PATCH_REPO clones a
# fork instead of this repo.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || true)"
if [ -n "$SELF_DIR" ] && [ -x "$SELF_DIR/scripts/imac-patcher" ]; then
    echo "==> Using this checkout: $SELF_DIR"
    exec "$SELF_DIR/scripts/imac-patcher" "$@"
fi

REPO_URL="${IMAC_PATCH_REPO:-https://github.com/ahmadtv/omarchy-imac18-3}"
DEST="${IMAC_PATCH_DIR:-$HOME/.local/share/omarchy-imac18-3}"
# The repo was briefly called omarchy-imac5k. A clone made then keeps updating
# in place rather than a second copy appearing beside it.
OLD="$HOME/.local/share/omarchy-imac5k"
if [ -z "${IMAC_PATCH_DIR:-}" ] && [ ! -d "$DEST/.git" ] && [ -d "$OLD/.git" ]; then
    DEST="$OLD"
fi

command -v git >/dev/null || { echo "git is required — install it first (e.g. sudo pacman -S git)"; exit 1; }

if [ -d "$DEST/.git" ]; then
    echo "==> Updating $DEST"
    git -C "$DEST" pull --ff-only
else
    echo "==> Cloning into $DEST"
    mkdir -p "$(dirname "$DEST")"
    git clone "$REPO_URL" "$DEST"
fi

echo "==> Launching the patcher"
exec "$DEST/scripts/imac-patcher" "$@"
